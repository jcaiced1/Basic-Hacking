def get_location(ip):
    try:
        # Always use the Tor proxy
        proxies = {
            'http': 'socks5h://127.0.0.1:9050',
            'https': 'socks5h://127.0.0.1:9050'
        }

        # Fetch the geolocation using the IP through the Tor proxy
        response = requests.get(f"http://ip-api.com/json/{ip}", proxies=proxies, timeout=10)

        content_type = response.headers.get('Content-Type', '').lower()
        if 'application/json' in content_type:
            data = response.json()
            if data['status'] == 'success':
                return data['country'], data['regionName'], data['city'], data['timezone']
            else:
                print(f"Location fetch failed for IP: {ip}. Response: {data}")
        else:
            print(f"Unexpected content-type: {content_type}")
            print(f"Response body: {response.text}")
        return None
    except requests.exceptions.RequestException as e:
        print(f"Error getting location: {e}")
        return None


# Function to check if the current time is within waking hours
def is_waking_time(timezone):
    try:
        tz = pytz.timezone(timezone)
        current_time = datetime.now(tz)
        current_hour = current_time.hour
        current_minute = current_time.minute
        current_weekday = current_time.weekday()

        # Weekdays (Monday to Friday)
        if current_weekday < 5:
            if (current_hour > 6 or (current_hour == 6 and current_minute >= 30)) and current_hour < 22:
                return True
        # Weekends (Saturday and Sunday)
        else:
            if (current_hour > 7 or (current_hour == 7 and current_minute >= 30)) and current_hour < 22:
                return True
        return False
    except Exception as e:
        print(f"Error determining waking time for timezone {timezone}: {e}")
        return False


