        # Randomly decide how many visits will happen this hour (between 2 and 6)
        visits_this_hour = random.randint(2, 6)
        print(f"Planned visits for this hour: {visits_this_hour}")

        total_time_available = 3600  # Total seconds in an hour
        time_for_visits = total_time_available / visits_this_hour  # Time available for each visit

        for visit in range(visits_this_hour):
            # Switch to a new Tor IP
            switch_tor_ip()

            # Get current IP using Tor
            ip = get_current_ip()
            if ip:
                print(f"Current IP: {ip}")

                location_info = fetch_with_retries(lambda: get_location(ip))
                if location_info is None:
                    print("Failed to get location. Switching to a new IP after a short delay...")
                    time.sleep(random.uniform(5, 10))
                    continue

                country, region, city, timezone = location_info
                local_time = get_local_time(timezone)
                print(f"IP Location: {country}, {region}, {city}, Timezone: {timezone}, Local Time: {local_time}")

                # Use the timezone to check if it's waking time
                if not is_waking_time(timezone):
                    print(f"It's not waking time in this location ({local_time}). Switching to a new IP after a short delay...")
                    time.sleep(random.uniform(5, 10))
                    continue

                # Step 1: Create the driver using Tor and visit the website
                driver = create_driver_with_tor()

                # Step 2: Visit mywebsite.com directly
                visit_website(driver)

                driver.quit()  # Close the browser after the visit

                # Calculate the delay based on the total available time for each visit
                # Add a slight random variation to the delay (e.g., +/- 2 minutes)
                delay = time_for_visits + random.uniform(-120, 120)  # Between -2 to +2 minutes variation
                print(f"Waiting for {delay / 60:.2f} minutes before the next visit.")
                time.sleep(delay)
            else:
                print("Failed to get IP. Switching to a new IP after a short delay...")
                time.sleep(random.uniform(5, 10))
                continue

        print(f"Completed all {visits_this_hour} visits for this hour.")

