def fetch_with_retries(func, retries=3, backoff_factor=1.5):
    """
    Executes a function and retries it up to a number of times if it fails.
    Parameters:
        func (function): The function to execute.
        retries (int): Number of retry attempts.
        backoff_factor (float): Factor by which to increase the wait time after each retry.
    Returns:
        The result of the function if successful, or None if all retries fail.
    """
    attempt = 0
    while attempt < retries:
        try:
            return func()  # Try to execute the function
        except Exception as e:
            attempt += 1
            wait_time = backoff_factor ** attempt  # Exponential backoff
            print(f"Error: {e}. Retrying in {wait_time:.2f} seconds...")
            time.sleep(wait_time)
    print(f"Failed after {retries} attempts.")
    return None


# Function to run visits only during waking hours
