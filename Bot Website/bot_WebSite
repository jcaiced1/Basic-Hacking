def create_driver_with_tor(retries=3):
    for attempt in range(retries):
        try:
            # Create a Firefox profile that routes traffic through the Tor proxy (Socks5)
            firefox_profile = webdriver.FirefoxProfile()

            # Set up the proxy server to route traffic through Tor (Socks5)
            firefox_profile.set_preference("network.proxy.type", 1)  # Manual proxy configuration
            firefox_profile.set_preference("network.proxy.socks", "127.0.0.1")
            firefox_profile.set_preference("network.proxy.socks_port", 9050)
            firefox_profile.set_preference("network.proxy.socks_version", 5)

            # Disable DNS through the proxy (use Tor's DNS)
            firefox_profile.set_preference("network.proxy.socks_remote_dns", True)

            # Disable WebRTC to prevent IP leaks
            firefox_profile.set_preference("media.peerconnection.enabled", False)

            # Set random user agent and window size
            options = Options()
            user_agent, device_type = get_random_user_agent()
            options.set_preference("general.useragent.override", user_agent)
            width, height = get_random_screen_resolution(device_type)
            options.add_argument(f"--window-size={width},{height}")

            # Add the profile to the options
            options.profile = firefox_profile  # This is the correct way to add the profile

            # Start Firefox with the configured options
            driver = webdriver.Firefox(options=options)

            # Clear cookies at the start of the session
            driver.delete_all_cookies()

            print(f"Using Screen Resolution: {width}x{height}")
            print("Cookies cleared and Tor proxy is set.")
            return driver
        except TimeoutException as e:
            print(f"Attempt {attempt + 1}/{retries}: Failed to start Firefox. Retrying...")
            time.sleep(5)  # Wait before retrying
    raise TimeoutException("Failed to start Firefox after multiple attempts.")

