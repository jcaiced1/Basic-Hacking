# Function to get the current local time in the specified timezone
def get_local_time(timezone):
    try:
        tz = pytz.timezone(timezone)
        local_time = datetime.now(tz)
        formatted_time = local_time.strftime('%I:%M %p')  # 12-hour format (e.g., 02:30 PM)
        return formatted_time
    except Exception as e:
        print(f"Error getting local time for timezone {timezone}: {e}")
        return None

